---
import Icon from './Icon.astro';

interface Props {
  icon?: string;
  size?: number;
}
const { icon, size = 48 } = Astro.props;
---

{
  icon ? (
    <img class="plugin-icon" src={icon} alt="" width={size} height={size} />
  ) : (
    <span class="plugin-icon none" style={`width:${size}px;height:${size}px`}>
      <Icon name="Puzzle" size={Math.round(size / 2)} />
    </span>
  )
}
