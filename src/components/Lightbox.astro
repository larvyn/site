---
// Click a screenshot, or a picture in a blog post, to see it full size.
// Esc, the close button or a click outside closes it; ← and → move between images.
import Icon from './Icon.astro';
---

<dialog class="lightbox" aria-label="Image viewer">
  <button class="lb-btn lb-close" type="button" aria-label="Close"><Icon name="X" size={20} /></button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous image"><Icon name="ChevronLeft" size={24} /></button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="lb-btn lb-next" type="button" aria-label="Next image"><Icon name="ChevronRight" size={24} /></button>
</dialog>

<style is:global>
  .zoomable { cursor: zoom-in; }
  .zoomable:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: transparent; color: var(--text); overflow: hidden;
  }
  .lightbox::backdrop { background: rgb(4 4 6 / 0.88); backdrop-filter: blur(6px); }
  .lightbox[open] { display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; animation: lb-in 0.18s ease-out; }
  .lightbox figure { margin: 0; grid-column: 2; display: grid; justify-items: center; gap: 12px; min-width: 0; }
  .lightbox img {
    max-width: 100%; max-height: calc(100dvh - 110px); width: auto; height: auto;
    border-radius: 12px; border: 1px solid var(--line-2); box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
    cursor: zoom-out; background: var(--bg-1);
  }
  .lightbox figcaption { font-size: 14.5px; color: var(--text-2); text-align: center; }
  .lightbox figcaption:empty { display: none; }
  .lightbox figcaption b { color: var(--text); margin-right: 6px; }
  .lb-btn {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 99px; cursor: pointer;
    border: 1px solid var(--line-2); background: var(--bg-2); color: var(--text);
  }
  .lb-btn:hover { border-color: var(--accent-line); }
  .lb-btn[hidden] { display: none; }
  .lb-close { position: fixed; top: 16px; right: 16px; }
  .lb-prev { grid-column: 1; justify-self: center; }
  .lb-next { grid-column: 3; justify-self: center; }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.98); } }
  @media (max-width: 700px) {
    .lightbox[open] { grid-template-columns: 1fr; padding: 16px; }
    .lightbox figure { grid-column: 1; }
    .lb-prev, .lb-next { position: fixed; bottom: 16px; }
    .lb-prev { left: 16px; } .lb-next { right: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .lightbox[open] { animation: none; } }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const big = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
  const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;

  // Screenshots, and pictures in blog posts. The post cover and card thumbnails stay plain.
  const images = [...document.querySelectorAll<HTMLImageElement>('.screen img, .prose img')];
  let index = 0;
  let opener: HTMLElement | null = null;

  /** The widest candidate in srcset, so the big view isn't the thumbnail. */
  function largest(img: HTMLImageElement) {
    let best = img.currentSrc || img.src;
    let bestW = 0;
    for (const part of img.srcset.split(',')) {
      const [url, w] = part.trim().split(/\s+/);
      const n = parseInt(w ?? '', 10);
      if (url && n > bestW) [best, bestW] = [url, n];
    }
    return best;
  }

  /** The text shown under the image: a tour tab's caption, a gallery figure's, or a post figure's. */
  function captionOf(img: HTMLImageElement): Element | null {
    const tour = img.closest('.tour-panel')?.querySelector('.tour-caption');
    if (tour) return tour;
    const fig = img.closest('.screen')?.parentElement?.closest('figure') ?? img.closest('figure');
    return fig?.querySelector('figcaption') ?? null;
  }

  // Only the images people can see right now: a hidden tour tab is skipped.
  const visible = () => images.filter((img) => img.offsetParent !== null);

  function show(img: HTMLImageElement) {
    const list = visible();
    index = Math.max(0, list.indexOf(img));
    big.src = largest(img);
    big.alt = img.alt;
    // Copied node by node, so a caption's bold title stays bold.
    caption.replaceChildren(...[...(captionOf(img)?.childNodes ?? [])].map((n) => n.cloneNode(true)));
    prev.hidden = next.hidden = list.length < 2;
    if (!dialog.open) {
      opener = img;
      dialog.showModal();
    }
  }

  function step(by: number) {
    const list = visible();
    if (list.length < 2) return;
    show(list[(index + by + list.length) % list.length]);
  }

  for (const img of images) {
    img.classList.add('zoomable');
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `View larger: ${img.alt}`);
    img.addEventListener('click', () => show(img));
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        show(img);
      }
    });
  }

  dialog.addEventListener('close', () => {
    big.removeAttribute('src');
    opener?.focus();
  });

  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  prev.addEventListener('click', () => step(-1));
  next.addEventListener('click', () => step(1));
  big.addEventListener('click', () => dialog.close());
  // A click on the dimmed area around the image closes it.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
</script>
