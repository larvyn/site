---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
}

// The screenshots already include Larvyn's own title bar, so the frame is only a border and a shadow.
const { src, alt, eager = false, class: cls = '' } = Astro.props;
---

<figure class:list={['screen', cls]}>
  <Image
    src={src}
    alt={alt}
    widths={[720, 1080, 1440]}
    sizes="(max-width: 900px) 100vw, 1100px"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    format="webp"
    quality={88}
  />
</figure>
