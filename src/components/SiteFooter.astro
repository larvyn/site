---
import { getPosts } from '../lib/blog';
import { ISSUES, RELEASES } from '../lib/links';
import { ALL_PAGES } from '../lib/pages';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const at = (hash: string) => (home ? hash : `/${hash}`);
const hasPosts = (await getPosts()).length > 0;
---

<footer>
  <div class="wrap">
    <a class="brand" href={home ? '#top' : '/'}><img src="/favicon.svg" alt="" width="24" height="24" />Larvyn</a>
    <nav aria-label="Footer">
      <a href={at('#tour')}>Tour</a>
      <a href={at('#features')}>Features</a>
      <a href={at('#faq')}>FAQ</a>
      {hasPosts && <a href="/blog/">Blog</a>}
      <a href={at('#install')}>Install</a>
      <a href={RELEASES}>Releases</a>
      <a href={ISSUES}>Report a bug</a>
    </nav>
    <nav class="footer-pages" aria-label="Features and comparisons">
      {ALL_PAGES.map((p) => <a href={p.path}>{p.label}</a>)}
    </nav>
    <span>
      © {new Date().getFullYear()} Ivan Mercedes &amp; Elminson De Oleo Baez. Laravel is a trademark of Laravel Holdings Inc.
      Larvyn is not affiliated with or endorsed by Laravel.
    </span>
  </div>
</footer>
