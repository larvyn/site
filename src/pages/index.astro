---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Screen from '../components/Screen.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { RELEASES_REPO, RELEASES, ISSUES, DISCUSSIONS } from '../lib/links';
import { STARTER } from '../lib/plugins';

// Brand logos, keyed by file name: from thesvg.org, or from the project's own site when thesvg.org
// has none. PHPUnit has no icon, only a wordmark, which then stands in for the name.
const logos = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/brands/*.{svg,png}', { eager: true }))
    .map(([path, mod]) => [path.split('/').pop()!.replace(/\.(svg|png)$/, ''), mod.default.src]),
);

import overviewRunning from '../assets/screens/overview-running.png';
import agents from '../assets/screens/agents.png';
import terminals from '../assets/screens/terminals.png';
import tests from '../assets/screens/tests.png';
import logs from '../assets/screens/logs.png';
import database from '../assets/screens/database.png';
import models from '../assets/screens/models.png';
import routes from '../assets/screens/routes.png';
import tinker from '../assets/screens/tinker.png';
import queues from '../assets/screens/queues.png';
import git from '../assets/screens/git.png';
import deps from '../assets/screens/deps.png';
import artisan from '../assets/screens/artisan.png';
import env from '../assets/screens/env.png';
import overview from '../assets/screens/overview.png';
import paletteAgent from '../assets/screens/palette-agent.png';
import files from '../assets/screens/files.png';
import fileFinder from '../assets/screens/file-finder.png';
import newApp from '../assets/screens/new-app.png';
import pluginMailpit from '../assets/screens/plugin-mailpit.png';
import pluginsMarketplace from '../assets/screens/plugins-marketplace.png';
import pluginPermissions from '../assets/screens/plugin-permissions.png';
import pluginConfirm from '../assets/screens/plugin-confirm-command.png';
import pluginCommands from '../assets/screens/plugin-commands.png';

const DOWNLOAD = '#install';
// Short URLs served by public/_redirects, which point at the scripts in the releases repo.
const SCRIPTS = 'https://larvyn.dev';

const installs = [
  { id: 'windows', label: 'Windows', icon: 'Monitor', shell: 'PowerShell', cmd: `irm ${SCRIPTS}/install.ps1 | iex`, note: 'Installs to your user folder, no administrator rights needed, and adds Larvyn to the Start menu.' },
  { id: 'macos', label: 'macOS', icon: 'Laptop', shell: 'Terminal', cmd: `curl -fsSL ${SCRIPTS}/install.sh | sh`, note: 'Installs Larvyn.app to ~/Applications. Universal build for Apple Silicon and Intel.' },
  { id: 'linux', label: 'Linux', icon: 'Terminal', shell: 'Terminal', cmd: `curl -fsSL ${SCRIPTS}/install.sh | sh`, note: 'Installs to ~/.local/bin and adds Larvyn to your apps menu. Needs GTK 4 and WebKitGTK 6.0 (Ubuntu 24.04+, Fedora 39+, Arch); the installer tells you if they are missing.' },
] as const;

// Newest release (prereleases included) at build time; the page still builds offline.
let version = 'beta';
try {
  const res = await fetch(`https://api.github.com/repos/${RELEASES_REPO}/releases?per_page=1`, {
    headers: { 'User-Agent': 'larvyn-site' },
    signal: AbortSignal.timeout(5000),
  });
  const [latest] = res.ok ? await res.json() : [];
  if (latest?.tag_name) version = latest.tag_name;
} catch {}

const tour = [
  { id: 'overview', label: 'Overview', icon: 'LayoutDashboard', img: overview, text: '<b>Your project at a glance.</b> Versions, packages, .env facts, recent commits, a Doctor that checks your setup, and the whole dev stack one switch away.' },
  { id: 'agents', label: 'Agents', icon: 'Bot', img: agents, text: '<b>Describe it, launch it.</b> Pick one or more coding agents, each gets its own git worktree with your .env and SQLite copied. Laravel playbooks get you started.' },
  { id: 'terminals', label: 'Terminals', icon: 'SquareTerminal', img: terminals, text: '<b>Real terminals that never die.</b> Full PTY with colors, links and search. Switch views or projects and they keep running with their scrollback.' },
  { id: 'tests', label: 'Tests', icon: 'TestTube2', img: tests, text: '<b>Every test, every failure, the exact line.</b> Run Pest or PHPUnit, re-run only what failed, open the file or hand the failure to an agent.' },
  { id: 'logs', label: 'Logs', icon: 'ScrollText', img: logs, text: '<b>laravel.log, readable.</b> Live tail with levels, parsed exceptions and stack frames that open in your editor. One click asks an agent to fix it.' },
  { id: 'database', label: 'Database', icon: 'Database', img: database, text: '<b>Browse and edit rows.</b> Tables, structure, foreign keys and a SQL console, all through your app’s own connection. MySQL, Postgres, SQLite, SQL Server.' },
  { id: 'models', label: 'Models', icon: 'Box', img: models, text: '<b>Eloquent, mapped.</b> Attributes, casts, fillable and guarded fields, relationships in both directions and record counts for every model.' },
  { id: 'routes', label: 'Routes', icon: 'Waypoints', img: routes, text: '<b>Every route, filterable.</b> Methods, names, actions and middleware. Jump from a route straight to its controller method.' },
  { id: 'tinker', label: 'Tinker', icon: 'FlaskConical', img: tinker, text: '<b>Tinker with an editor.</b> Run PHP inside your booted app, see dumps or JSON, timing, memory and query count. Snippets and history included.' },
  { id: 'queues', label: 'Queues', icon: 'Timer', img: queues, text: '<b>Queues and schedule.</b> Failed jobs with their exceptions, retry or flush them, and every scheduled task with its next run.' },
  { id: 'git', label: 'Git', icon: 'GitBranch', img: git, text: '<b>Source control built in.</b> Status, diffs, commit, branches and worktrees, without leaving the app.' },
  { id: 'files', label: 'Files', icon: 'FolderTree', img: files, text: '<b>Browse and edit your code.</b> The project tree and an editor with highlighting for PHP, Blade, JS/TS, Vue and more. Ctrl P jumps to any file by a few letters of its name.' },
  { id: 'deps', label: 'Dependencies', icon: 'Package', img: deps, text: '<b>Stay current and safe.</b> Outdated Composer packages split into safe and major updates, plus composer audit for known CVEs.' },
  { id: 'mail', label: 'Mail', icon: 'Mail', img: pluginMailpit, text: '<b>Plugins add their own views.</b> The Mailpit plugin runs Mailpit in the stack and shows every email your app sends, right in the sidebar.' },
] as const;

const features = [
  { icon: 'SquareTerminal', title: 'Persistent terminals', text: 'PTY sessions that survive view and project switches, with bell alerts when a process needs you.' },
  { icon: 'Bot', title: 'Parallel agents', text: 'Claude Code, Codex, Antigravity CLI, Cursor Agent, OpenCode, Aider and Pi, side by side.' },
  { icon: 'GitFork', title: 'Isolated worktrees', text: 'Each agent works on its own larvyn/<task> branch. Review the diff, merge the winner.' },
  { icon: 'Server', title: 'One-click dev stack', text: 'serve, Vite, queue or Horizon, scheduler, Pail, Reverb and Octane, together or one by one.' },
  { icon: 'Zap', title: 'Artisan studio', text: 'Every command with its arguments as a form, favourites, and a generator for anything make: creates.' },
  { icon: 'Waypoints', title: 'Route explorer', text: 'Filter by method, URI, name or middleware and open the controller at the right line.' },
  { icon: 'Box', title: 'Model inspector', text: 'Attributes, casts and relationships for every Eloquent model, plus record counts.' },
  { icon: 'Database', title: 'Database browser', text: 'Rows, structure, indexes, migrations and a SQL console through your app’s connection.' },
  { icon: 'FlaskConical', title: 'Tinker editor', text: 'Write PHP, run it in your app, read dumps or JSON with timing and query counts.' },
  { icon: 'TestTube2', title: 'Test runner', text: 'Pest and PHPUnit with per-test results, filters, parallel runs and failure details.' },
  { icon: 'ScrollText', title: 'Log viewer', text: 'Live laravel.log with parsed exceptions and frames that open in your editor.' },
  { icon: 'Timer', title: 'Queues & schedule', text: 'Failed jobs, retries and every scheduled task with its next run time.' },
  { icon: 'Braces', title: '.env editor', text: 'Edit the environment safely: a backup is kept before every save.' },
  { icon: 'ShieldCheck', title: 'Security audit', text: 'composer audit and outdated packages with one-click safe updates.' },
  { icon: 'Stethoscope', title: 'Project doctor', text: 'Checks vendor, APP_KEY, storage link, migrations and frontend dependencies.' },
  { icon: 'Command', title: 'Command palette', text: 'Ctrl K understands artisan, shell, PHP and plain English.' },
  { icon: 'FolderTree', title: 'Files & finder', text: 'Browse and edit your code, and jump to any file with Ctrl P.' },
  { icon: 'FolderPlus', title: 'New Laravel app', text: 'Starter kit, Pest or PHPUnit and database, ready to run.' },
  { icon: 'History', title: 'Workspace restore', text: 'Terminals, agents and services come back after a restart.' },
  { icon: 'Puzzle', title: 'Plugins', text: 'Add commands, services and views from the marketplace.' },
] as const;

const stack: [name: string, color: string, logo?: string][] = [
  ['Laravel 10–13', '#ff2d20', 'laravel'], ['Herd', '#ff6a3d', 'herd'], ['Flock', '#22b8cf', 'flock'], ['Pest', '#a77bff', 'pest'], ['PHPUnit', '#4c8dff', 'phpunit-wordmark'], ['Livewire', '#fb70a9', 'livewire'],
  ['Inertia', '#9553e9', 'inertia'], ['Filament', '#f5c542', 'filament'], ['Horizon', '#8b5cf6', 'horizon'], ['Reverb', '#ff2d20', 'reverb'], ['Octane', '#2dd4bf', 'octane'],
  ['Vite', '#a77bff', 'vite'], ['Tailwind', '#38bdf8', 'tailwind'], ['Claude Code', '#d97757', 'claude-code'], ['Codex', '#3ddc84', 'codex'], ['Antigravity CLI', '#4c8dff', 'antigravity'],
  ['Cursor Agent', '#a3a3ad', 'cursor'], ['OpenCode', '#f5c542', 'opencode'], ['Aider', '#2dd4bf', 'aider'], ['Pi', '#a3a3ad', 'pi'], ['MySQL', '#4c8dff', 'mysql'], ['PostgreSQL', '#38bdf8', 'postgresql'], ['SQLite', '#a3a3ad', 'sqlite'],
];
---

<Base
  title="Larvyn: the Laravel workbench"
  description="A free desktop app for Laravel: persistent terminals, parallel coding agents in git worktrees and every Laravel tool in one native window."
>
  <SiteHeader home />

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="grid-bg"></div>
      <div class="wrap">
        <a class="pill" href="#install"><b>BETA</b> {version} is out for Windows, macOS and Linux <Icon name="ArrowRight" size={14} /></a>
        <h1>Your whole Laravel workflow.<br /><span class="grad">One native app.</span></h1>
        <p class="lead">
          Larvyn puts persistent terminals, parallel AI coding agents and every Laravel tool you reach for (Artisan, routes, models, database, Tinker, tests, queues and logs) into one fast desktop app.
        </p>
        <div class="cta">
          <a class="btn primary" href={DOWNLOAD}><Icon name="Download" size={18} /> <span data-os-label>Install the beta</span></a>
          <a class="btn" href="#tour"><Icon name="Play" size={16} /> Take the tour</a>
        </div>
        <div class="meta">
          <span><Icon name="Check" size={15} /> Free, no account</span>
          <span><Icon name="Check" size={15} /> Works with Herd and Flock</span>
          <span><Icon name="Check" size={15} /> Laravel 10 to 13</span>
          <span><Icon name="Check" size={15} /> Your code stays on your machine</span>
        </div>

        <div class="hero-shot" id="hero-shot">
          <div class="float f1"><span class="dot"></span><div>3 services running<small>serve · vite · queue</small></div></div>
          <div class="float f2"><Icon name="TestTube2" size={18} class="c-red" /><div>16 tests · 2 failing<small>Ask an agent to fix them</small></div></div>
          <div class="float f3"><Icon name="GitBranch" size={18} /><div>larvyn/stock-validation<small>agent finished · +42 −3</small></div></div>
          <Screen src={overviewRunning} alt="Larvyn overview of a Laravel project with the dev stack running" eager />
        </div>
      </div>
    </section>

    <!-- Works with -->
    <section class="logos">
      <p>Built for the Laravel ecosystem and the agents you already use</p>
      <div class="marquee">
        <div class="marquee-track">
          {[...stack, ...stack].map(([name, color, logo]) => (
            <span class="tag">{logo?.endsWith('-wordmark')
              ? <img class="wordmark" src={logos[logo]} alt={name} height="16" />
              : <>{logo ? <img class="logo" src={logos[logo]} alt="" width="16" height="16" /> : <i style={`background:${color}`}></i>}{name}</>}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="block">
      <div class="wrap">
        <div class="head reveal">
          <span class="eyebrow"><Icon name="Sparkles" size={14} /> Three tools in one</span>
          <h2>Terminals, agents and Laravel. Finally in the same window.</h2>
          <p>Stop juggling a terminal app, an agent manager, a database client, a log viewer and five browser tabs. Larvyn knows it is a Laravel project and builds everything around that.</p>
        </div>
        <div class="pillars">
          <div class="pillar reveal" style="--c: var(--cyan)">
            <div class="ico"><Icon name="SquareTerminal" size={22} /></div>
            <h3>Terminals that stay alive</h3>
            <p>Real PTY sessions per project. They keep running when you switch views, keep 1&nbsp;MB of scrollback and tell you when something needs attention.</p>
            <ul>
              <li><Icon name="Check" size={15} /> Colors, links, search and resize</li>
              <li><Icon name="Check" size={15} /> Bell alerts and activity markers</li>
              <li><Icon name="Check" size={15} /> A console drawer for every command you run</li>
            </ul>
          </div>
          <div class="pillar reveal" style="--c: var(--accent-2)">
            <div class="ico"><Icon name="Bot" size={22} /></div>
            <h3>Agents in parallel</h3>
            <p>Send one task to several agents at once. Each works in its own git worktree, so nothing collides. Compare the diffs and merge the best one.</p>
            <ul>
              <li><Icon name="Check" size={15} /> Seven agent CLIs supported</li>
              <li><Icon name="Check" size={15} /> .env and SQLite copied into each worktree</li>
              <li><Icon name="Check" size={15} /> Live status: working, waiting, done</li>
            </ul>
          </div>
          <div class="pillar reveal" style="--c: var(--green)">
            <div class="ico"><Icon name="Layers" size={22} /></div>
            <h3>Laravel, natively</h3>
            <p>Larvyn boots your app to read real data: routes, models, config, schedule, failed jobs and your database, through your own connection.</p>
            <ul>
              <li><Icon name="Check" size={15} /> 12 dedicated Laravel views</li>
              <li><Icon name="Check" size={15} /> Tests and logs that link to the line</li>
              <li><Icon name="Check" size={15} /> One switch starts the whole dev stack</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Tour -->
    <section class="block" id="tour" style="padding-top: 40px">
      <div class="wrap">
        <div class="head reveal">
          <span class="eyebrow"><Icon name="MousePointerClick" size={14} /> Product tour</span>
          <h2>Everything a Laravel app needs, one click away.</h2>
          <p>Real screenshots of Larvyn working on a sample store app.</p>
        </div>
        <div class="tour-tabs" role="tablist">
          {tour.map((t, i) => (
            <button class="tour-tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={t.id}>
              <Icon name={t.icon} size={15} /> {t.label}
            </button>
          ))}
        </div>
        <div class="tour-stage reveal">
          {tour.map((t, i) => (
            <div class:list={['tour-panel', i === 0 && 'active']} data-panel={t.id} role="tabpanel">
              <Screen src={t.img} alt={`Larvyn ${t.label} view`} />
              <p class="tour-caption" set:html={t.text} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Agents -->
    <section class="block" id="agents">
      <div class="wrap split">
        <div class="copy reveal">
          <span class="eyebrow"><Icon name="Bot" size={14} /> Parallel agents</span>
          <h2>One prompt. Several agents. Pick the best result.</h2>
          <p>Write what you want in plain words. Larvyn creates a worktree per agent, copies your environment, starts each agent and shows its terminal live. When they finish, review every diff and merge with one click.</p>
          <div class="lanes">
            <div class="lane"><span class="av"><img src={logos['claude-code']} alt="" width="18" height="18" /></span><div>Claude Code<code>larvyn/stock-validation-1</code></div><span class="st done">Done · +42 −3</span></div>
            <div class="lane"><span class="av"><img src={logos['codex']} alt="" width="18" height="18" /></span><div>Codex<code>larvyn/stock-validation-2</code></div><span class="st work">Working</span></div>
            <div class="lane"><span class="av"><img src={logos['antigravity']} alt="" width="18" height="18" /></span><div>Antigravity CLI<code>larvyn/stock-validation-3</code></div><span class="st wait">Needs you</span></div>
          </div>
        </div>
        <div class="reveal"><Screen src={agents} alt="Larvyn agents view with a prompt and Laravel playbooks" /></div>
      </div>
    </section>

    <!-- Tests -->
    <section class="block">
      <div class="wrap split rev">
        <div class="copy reveal">
          <span class="eyebrow"><Icon name="TestTube2" size={14} /> Tests</span>
          <h2>From red to green without hunting.</h2>
          <p>Larvyn runs <code>php artisan test</code> and shows every test grouped by class. Failures come with the message, the trace and the exact line in your code, not in vendor/.</p>
          <ul class="points">
            <li><span class="ico"><Icon name="RotateCcw" size={16} /></span><div><b>Re-run only what failed</b><span>Or a single test, with one click.</span></div></li>
            <li><span class="ico"><Icon name="Code2" size={16} /></span><div><b>Open the failing line</b><span>In VS Code, Cursor, PhpStorm, Zed, Windsurf, Sublime or Neovim.</span></div></li>
            <li><span class="ico"><Icon name="Bot" size={16} /></span><div><b>Ask an agent to fix it</b><span>The failure and trace go with the prompt.</span></div></li>
          </ul>
        </div>
        <div class="reveal"><Screen src={tests} alt="Larvyn test runner with a failing test expanded" /></div>
      </div>
    </section>

    <!-- Logs -->
    <section class="block">
      <div class="wrap split">
        <div class="copy reveal">
          <span class="eyebrow"><Icon name="ScrollText" size={14} /> Logs</span>
          <h2>Exceptions you can act on.</h2>
          <p>A live view of laravel.log that parses every entry: level, time, exception class and the first frame in your app. Expand an error to see the full trace, open the file, or send it to an agent.</p>
          <ul class="points">
            <li><span class="ico"><Icon name="Radio" size={16} /></span><div><b>Live tail</b><span>New entries appear as they are written.</span></div></li>
            <li><span class="ico"><Icon name="Filter" size={16} /></span><div><b>Filter by level and text</b><span>Errors, warnings, info, or any word.</span></div></li>
          </ul>
        </div>
        <div class="reveal"><Screen src={logs} alt="Larvyn log viewer with an expanded exception" /></div>
      </div>
    </section>

    <!-- Database -->
    <section class="block">
      <div class="wrap split rev">
        <div class="copy reveal">
          <span class="eyebrow"><Icon name="Database" size={14} /> Database</span>
          <h2>A database client that already knows your app.</h2>
          <p>No connection strings to copy. Larvyn reads your tables through Laravel’s own connection, so it works with whatever your .env points at.</p>
          <ul class="points">
            <li><span class="ico"><Icon name="Table" size={16} /></span><div><b>Browse, search and edit rows</b><span>Paginated, with inline updates and deletes.</span></div></li>
            <li><span class="ico"><Icon name="TerminalSquare" size={16} /></span><div><b>SQL console</b><span>Run queries and read results in a grid.</span></div></li>
            <li><span class="ico"><Icon name="ListChecks" size={16} /></span><div><b>Migrations</b><span>See what ran and what is pending.</span></div></li>
          </ul>
        </div>
        <div class="reveal"><Screen src={database} alt="Larvyn database browser showing the orders table" /></div>
      </div>
    </section>

    <!-- Palette -->
    <section class="block" id="palette">
      <div class="wrap">
        <div class="head reveal">
          <span class="eyebrow"><Icon name="Command" size={14} /> Command palette</span>
          <h2>Type anything. Larvyn knows what you mean.</h2>
          <p>Ctrl K opens a palette that reads your intent: an artisan command, a shell line, a bit of PHP for Tinker, or a task for an agent. Try it.</p>
        </div>
        <div class="palette reveal" id="pal">
          <div class="palette-input">
            <Icon name="Search" size={20} />
            <input id="pal-input" value="add stock validation to checkout" aria-label="Try the command palette" autocomplete="off" spellcheck="false" />
          </div>
          <div class="palette-group">Run</div>
          <div class="palette-row" id="pal-row">
            <span id="pal-ico"></span>
            <span id="pal-text"></span>
            <span class="kind" id="pal-kind"></span>
          </div>
          <div class="palette-foot">
            <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
            <span><kbd>↵</kbd> run</span>
            <span><kbd>&gt;</kbd> artisan</span>
            <span><kbd>$</kbd> shell</span>
          </div>
          <template id="ico-agent"><Icon name="Bot" size={18} /></template>
          <template id="ico-artisan"><Icon name="Zap" size={18} /></template>
          <template id="ico-shell"><Icon name="SquareTerminal" size={18} /></template>
          <template id="ico-tinker"><Icon name="FlaskConical" size={18} /></template>
        </div>
        <div class="examples">
          <button data-ex="&gt;migrate:fresh --seed">&gt;migrate:fresh --seed</button>
          <button data-ex="$ npm run build">$ npm run build</button>
          <button data-ex="Order::where('status', 'paid')->sum('total')">Order::where(…)->sum('total')</button>
          <button data-ex="write Pest tests for the checkout flow">write Pest tests for checkout</button>
        </div>
      </div>
    </section>

    <!-- Features grid -->
    <section class="block" id="features">
      <div class="wrap">
        <div class="head reveal">
          <span class="eyebrow"><Icon name="LayoutGrid" size={14} /> Features</span>
          <h2>Everything you need. Nothing you have to configure.</h2>
          <p>Add a folder and Larvyn detects the Laravel version, packages, frontend, database, queue and Herd or Flock URL on its own.</p>
        </div>
        <div class="fgrid reveal">
          {features.map((f) => (
            <div class="fcell">
              <Icon name={f.icon} size={22} />
              <h4>{f.title}</h4>
              <p>{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Plugins -->
    <section class="block" id="plugins">
      <div class="wrap">
        <div class="head reveal">
          <span class="eyebrow"><Icon name="Puzzle" size={14} /> Plugins</span>
          <h2>Missing a tool? Add it with a plugin.</h2>
          <p>Mailpit, Horizon or the script your team runs ten times a day. Install plugins from the marketplace inside Larvyn, and they can only do what you allowed.</p>
        </div>
        <div class="pillars">
          <div class="pillar reveal" style="--c: var(--accent-2)">
            <div class="ico"><Icon name="Command" size={22} /></div>
            <h3>Commands in Ctrl K</h3>
            <p>Plugin commands show up in the palette, such as <i>Horizon: restart workers</i>, and run in a project terminal.</p>
          </div>
          <div class="pillar reveal" style="--c: var(--green)">
            <div class="ico"><Icon name="Server" size={22} /></div>
            <h3>Services in the Stack</h3>
            <p>Run something like Mailpit next to serve and Vite, with the same toggle, output and restart as Larvyn’s own services.</p>
          </div>
          <div class="pillar reveal" style="--c: var(--cyan)">
            <div class="ico"><Icon name="PanelLeft" size={22} /></div>
            <h3>Views in the sidebar</h3>
            <p>A screen of its own, such as a Mail inbox, in a sandboxed frame. Its buttons can run commands, Artisan and the dev stack.</p>
          </div>
        </div>
        <div class="plugin-shot reveal">
          <Screen src={pluginMailpit} alt="The Mailpit plugin's Mail view in Larvyn's sidebar, with order confirmation emails" />
        </div>
        <div class="gallery plugin-gallery">
          <figure class="reveal"><Screen src={pluginsMarketplace} alt="The plugin marketplace in Larvyn's settings" /><figcaption><b>A marketplace inside Larvyn</b>Install in one click. Downloads are checked against the marketplace’s checksum.</figcaption></figure>
