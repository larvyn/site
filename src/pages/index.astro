  <SiteFooter home />

  <script>
    // Reveal on scroll
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
      { rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    requestAnimationFrame(() => document.getElementById('hero-shot')?.classList.add('in'));

    // Product tour tabs
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tour-tab');
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        document.querySelectorAll<HTMLElement>('.tour-panel').forEach((p) => p.classList.toggle('active', p.dataset.panel === tab.dataset.tab));
      }),
    );

    // Command palette demo: the same intent rules as the app.
    const input = document.getElementById('pal-input') as HTMLInputElement;
    const ico = document.getElementById('pal-ico')!;
    const text = document.getElementById('pal-text')!;
    const kind = document.getElementById('pal-kind')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const looksLikePHP = (s: string) => /::|->|\(|\$\w|;/.test(s);
    const render = () => {
      const v = input.value.trim();
      let k = 'agent', label = `Ask an agent: <b>${esc(v || 'describe a task')}</b>`;
      if (v.startsWith('>')) (k = 'artisan'), (label = `php artisan <b>${esc(v.slice(1).trim() || '…')}</b>`);
      else if (v.startsWith('$')) (k = 'shell'), (label = `Run in terminal: <b>${esc(v.slice(1).trim() || '…')}</b>`);
      else if (looksLikePHP(v)) (k = 'tinker'), (label = `Run in Tinker: <b>${esc(v)}</b>`);
      ico.innerHTML = (document.getElementById(`ico-${k}`) as HTMLTemplateElement).innerHTML;
      text.innerHTML = label;
      kind.textContent = k;
    };
    input.addEventListener('input', render);
    document.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.ex!;
        render();
        input.focus();
      }),
    );
    render();

    // Install: open the visitor's OS tab, name it on the buttons, copy commands.
    const osTabs = document.querySelectorAll<HTMLButtonElement>('.install-tab');
    const showOS = (os: string) => {
      osTabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.os === os)));
      document.querySelectorAll<HTMLElement>('.install-panel').forEach((p) => p.classList.toggle('active', p.dataset.os === os));
    };
    osTabs.forEach((t) => t.addEventListener('click', () => showOS(t.dataset.os!)));
    const ua = navigator.userAgent;
    const os = /Windows/i.test(ua) ? 'windows' : /Mac/i.test(ua) && !/iPhone|iPad/i.test(ua) ? 'macos' : /Linux/i.test(ua) && !/Android/i.test(ua) ? 'linux' : '';
    if (os) {
      showOS(os);
      const name = { windows: 'Windows', macos: 'macOS', linux: 'Linux' }[os];
      document.querySelectorAll('[data-os-label]').forEach((el) => (el.textContent = `Install for ${name}`));
    }
    document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy!);
          b.classList.add('done');
          setTimeout(() => b.classList.remove('done'), 1600);
        } catch {}
      }),
    );
  </script>
