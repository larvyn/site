---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getPosts } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  /** Open Graph / Twitter image: an imported image (resized to 1200x630) or a path in public/. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** For articles: published and modified dates, author and tags. */
  article?: { published: Date; modified?: Date; author: string; tags?: string[] };
  /** Structured data (schema.org), one object or several. */
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description, image = '/og.png', imageAlt, type = 'website', article, jsonLd, noindex = false } = Astro.props;

const site = Astro.site ?? new URL('https://larvyn.dev');
const canonical = new URL(Astro.url.pathname, site).href;
// Crawlers want an absolute URL and a format every one of them reads.
const ogImage =
  typeof image === 'string'
    ? new URL(image, site).href
    : new URL((await getImage({ src: image, width: 1200, height: 630, format: 'jpeg', quality: 88 })).src, site).href;
// The feed is announced once it exists (a published post).
const hasFeed = (await getPosts()).some((p) => !p.data.draft);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
import Lightbox from '../components/Lightbox.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="VkiVIPOCZTQMisRU9xHvoP7DnOP7oYitOmVR1FzxR0E" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#08080a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {hasFeed && <link rel="alternate" type="application/rss+xml" title="Larvyn blog" href={new URL('/rss.xml', site).href} />}
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Larvyn" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          <meta property="article:author" content={article.author} />
          {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@ivanmerceces" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <slot />
    <Lightbox />
  </body>
</html>
