{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name the scoped API token was created for.
  "name": "larvyn-site",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "larvyn.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist"
  }
}
